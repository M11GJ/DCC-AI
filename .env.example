# このファイルを .env にコピーして実値を入れる。.env は Git に入れない。
# cp .env.example .env

# featherless の API キー（featherless.ai/account/api-keys）
FEATHERLESS_API_KEY=fw-xxxxxxxxxxxxxxxx

# Open WebUI(Pipe) → LiteLLM の認証キー。任意のランダム文字列。
# 生成例: printf 'sk-dcc-%s' "$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-dcc-REPLACE_WITH_RANDOM

# Discord Bot Token（読み取り専用権限: Read Message History, View Channels）
# Discord Developer Portal で Bot を作成し、サーバーに追加後に取得
DISCORD_BOT_TOKEN=

# Discord サーバー ID（右クリック → ID をコピー）
DISCORD_GUILD_ID=1304292402386964502

# 同期から除外するチャンネル名（カンマ区切り）
DISCORD_EXCLUDED_CHANNELS=A

# 初回取得日数（デフォルト: 90日分）
DISCORD_INITIAL_FETCH_DAYS=90
# Cloudflare Tunnel token (never commit the real value)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
