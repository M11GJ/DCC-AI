# --- 基本 ---
WEBUI_URL=https://ai.shu-dcc.net
WEBUI_SECRET_KEY=f469deb1083d8baafb025256152ad107676e36dc99d9010e68b8f31f8977fe3c
WEBUI_NAME=DCC AI

# --- 既定のモデル接続は使わない（DCCAI は Pipe で提供するため） ---
ENABLE_OLLAMA_API=false

# --- Discord ログイン（Worker 経由の OIDC） ---
ENABLE_OAUTH_SIGNUP=true

# ローカルログイン欄を消す（Discord のみに）
ENABLE_LOGIN_FORM=false

# まず Open WebUI のログイン画面を表示する（いきなり Discord に飛ばさない）
OAUTH_AUTO_REDIRECT=false

OAUTH_PROVIDER_NAME=Discord

# Discord Developer Portal → OAuth2 で取得
OAUTH_CLIENT_ID=1527977610624106686
OAUTH_CLIENT_SECRET=JRoVQJI26R9vn9eAufsN4pAJkHOOsMoz

# Worker デプロイ後に確定した OIDC エンドポイント
OPENID_PROVIDER_URL=https://dccai-oidc-worker.gunn-kousuke.workers.dev/.well-known/openid-configuration

OPENID_REDIRECT_URI=https://ai.shu-dcc.net/oauth/oidc/callback
OAUTH_SCOPES=openid email profile guilds
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
ENABLE_PERSISTENT_CONFIG=false
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=guilds
OAUTH_ALLOWED_ROLES=1304292402386964502
OAUTH_ADMIN_ROLES=__dccai_admin_none__
