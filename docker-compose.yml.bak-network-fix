services:
  open-webui:
    build: .
    image: dccai-open-webui:custom
    container_name: open-webui
    depends_on:
      - litellm
    ports:
      - "3000:8080"                # 前段のリバースプロキシから 3000 へ
    volumes:
      - open-webui:/app/backend/data
    env_file:
      - ./open-webui.env
    restart: unless-stopped

  litellm:
    image: ghcr.io/berriai/litellm:main-stable
    container_name: litellm
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    volumes:
      - ./litellm/config.yaml:/app/config.yaml:ro
    environment:
      - FEATHERLESS_API_KEY=${FEATHERLESS_API_KEY}
      - GEMINI_API_KEY_1=${GEMINI_API_KEY_1}
      - GEMINI_API_KEY_2=${GEMINI_API_KEY_2}
      - GEMINI_API_KEY_3=${GEMINI_API_KEY_3}
      - GEMINI_API_KEY_4=${GEMINI_API_KEY_4}
      - GEMINI_API_KEY_5=${GEMINI_API_KEY_5}
      - LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}
    # ポートは外部公開せず、open-webui からのみ内部ネットワークで到達
    expose:
      - "4000"
    restart: unless-stopped

  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared
    command: tunnel --no-autoupdate run --token eyJhIjoiYTYwYWU2Y2RiNjhjMjU5YjZkOGZhOGM1YjM4NWNiMmEiLCJ0IjoiMTg2OGJjZjktMjJiNC00ZmU3LTliZjYtMzE1MjY2ZjJjYzczIiwicyI6IlpESm1PREJqTkdRdE5qWmtPUzAwWmpKa0xXRXlNRFF0WWpCalpEWXpZMk5rWlRGaSJ9
    network_mode: host
    restart: unless-stopped

  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    volumes:
      - ollama:/root/.ollama
    restart: unless-stopped
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]

  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    volumes:
      - ./searxng:/etc/searxng
    networks:
      - dccai_net
    environment:
      - SEARXNG_BASE_URL=http://searxng:8080/
    # 外部公開なし（open-webui からの内部アクセスのみ）

volumes:
  open-webui: {}
  ollama: {}
